{
  "name": "paiyouju",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "牌友局私人 H5/PWA 德州扑克平台",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "admin:create": "corepack pnpm --filter @paiyouju/server admin:create",
    "backup:create": "corepack pnpm --filter @paiyouju/server backup:create",
    "backup:list": "corepack pnpm --filter @paiyouju/server backup:list",
    "backup:prune": "corepack pnpm --filter @paiyouju/server backup:prune",
    "backup:restore": "corepack pnpm --filter @paiyouju/server backup:restore",
    "backup:verify": "corepack pnpm --filter @paiyouju/server backup:verify",
    "audit:data": "corepack pnpm --filter @paiyouju/server audit:data",
    "audit:dependencies": "corepack pnpm --filter @paiyouju/server audit:dependencies",
    "public:test:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-public-test.ps1",
    "public:test:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/status-public-test.ps1",
    "public:test:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-public-test.ps1",
    "build:workspace-packages": "corepack pnpm --filter @paiyouju/shared build && corepack pnpm --filter @paiyouju/poker-core build",
    "dev": "corepack pnpm build:workspace-packages && concurrently --names web,server --prefix-colors cyan,green \"corepack pnpm --filter @paiyouju/web dev\" \"corepack pnpm --filter @paiyouju/server dev:local\"",
    "dev:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-lan-test.ps1",
    "dev:lan:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-lan-test-ui.ps1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "corepack pnpm build:workspace-packages && corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm build:workspace-packages && corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm --filter @paiyouju/server exec tsx scripts/run-docker-e2e.ts",
    "test:e2e:local": "corepack pnpm --filter @paiyouju/shared build && corepack pnpm --filter @paiyouju/web test:e2e",
    "test:e2e:docker": "corepack pnpm --filter @paiyouju/server exec tsx scripts/run-docker-e2e.ts",
    "test:e2e:pwa": "corepack pnpm --filter @paiyouju/web test:e2e:pwa",
    "test:protocol": "corepack pnpm --filter @paiyouju/server test:protocol",
    "test:ack": "corepack pnpm --filter @paiyouju/server test:ack",
    "test:snapshots": "corepack pnpm --filter @paiyouju/server test:snapshots",
    "test:recovery": "corepack pnpm --filter @paiyouju/server test:recovery",
    "test:recovery:process": "corepack pnpm --filter @paiyouju/server test:recovery:process",
    "test:postgres-concurrency": "corepack pnpm --filter @paiyouju/server test:postgres-concurrency",
    "test:action-idempotency": "corepack pnpm --filter @paiyouju/server test:action-idempotency",
    "test:settlement-exactly-once": "corepack pnpm --filter @paiyouju/server test:settlement-exactly-once",
    "test:runtime-cleanup": "corepack pnpm --filter @paiyouju/server test:runtime-cleanup",
    "test:realtime": "corepack pnpm --filter @paiyouju/server test:realtime",
    "verify:five-card-distribution": "corepack pnpm --filter @paiyouju/poker-core verify:five-card-distribution",
    "build": "corepack pnpm -r --if-present build",
    "db:generate": "corepack pnpm --filter @paiyouju/server db:generate",
    "db:validate": "corepack pnpm --filter @paiyouju/server db:validate",
    "db:docker:up": "corepack pnpm --filter @paiyouju/server db:docker:up",
    "db:docker:down": "corepack pnpm --filter @paiyouju/server db:docker:down",
    "db:docker:status": "corepack pnpm --filter @paiyouju/server db:docker:status",
    "db:docker:logs": "corepack pnpm --filter @paiyouju/server db:docker:logs",
    "db:docker:reset:dev": "corepack pnpm --filter @paiyouju/server db:docker:reset:dev",
    "db:docker:reset:test": "corepack pnpm --filter @paiyouju/server db:docker:reset:test",
    "db:migrate:docker": "corepack pnpm --filter @paiyouju/server db:migrate:docker",
    "db:migrate:test:docker": "corepack pnpm --filter @paiyouju/server db:migrate:test:docker",
    "db:seed:docker": "corepack pnpm --filter @paiyouju/server db:seed:docker",
    "db:seed:test:docker": "corepack pnpm --filter @paiyouju/server db:seed:test:docker",
    "db:dev:start": "corepack pnpm --filter @paiyouju/server db:dev:start",
    "db:dev:stop": "corepack pnpm --filter @paiyouju/server db:dev:stop",
    "db:test:start": "corepack pnpm --filter @paiyouju/server db:test:start",
    "db:test:stop": "corepack pnpm --filter @paiyouju/server db:test:stop",
    "db:test:reset": "corepack pnpm --filter @paiyouju/server db:test:reset",
    "db:migrate": "corepack pnpm --filter @paiyouju/server db:migrate",
    "db:migrate:test": "corepack pnpm --filter @paiyouju/server db:migrate:test",
    "db:migrate:dev": "corepack pnpm --filter @paiyouju/server db:migrate:dev",
    "db:seed": "corepack pnpm --filter @paiyouju/server db:seed",
    "db:seed:test": "corepack pnpm --filter @paiyouju/server db:seed:test",
    "db:studio": "corepack pnpm --filter @paiyouju/server db:studio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
