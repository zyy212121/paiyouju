{
  "name": "@paiyouju/server",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "admin:create": "tsx scripts/admin-create.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:list": "tsx scripts/backup.ts list",
    "backup:prune": "tsx scripts/backup.ts prune",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:verify": "tsx scripts/backup.ts verify",
    "audit:data": "tsx scripts/audit-data.ts",
    "audit:dependencies": "tsx scripts/audit-dependencies.ts",
    "dev": "tsx watch src/index.ts",
    "dev:local": "node scripts/start-local-development.mjs",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "smoke:built": "tsx scripts/smoke-built-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "corepack pnpm build && corepack pnpm db:migrate:test:docker && cross-env WEPOKER_STANDARD_POSTGRES=1 vitest run --config vitest.integration.config.ts",
    "test:postgres-concurrency": "vitest run --config vitest.postgres.config.ts",
    "test:protocol": "corepack pnpm --filter @paiyouju/shared test",
    "test:ack": "corepack pnpm --filter @paiyouju/web exec vitest run src/realtime/table-socket.test.ts",
    "test:snapshots": "vitest run src/modules/tables/snapshot/snapshot-codec.test.ts --config vitest.config.ts && cross-env WEPOKER_STANDARD_POSTGRES=1 vitest run src/modules/tables/snapshot/snapshot-repository.integration.test.ts --config vitest.integration.config.ts",
    "test:recovery": "cross-env WEPOKER_STANDARD_POSTGRES=1 vitest run src/modules/tables/recovery/recovery.integration.test.ts --config vitest.integration.config.ts",
    "test:recovery:process": "corepack pnpm build && cross-env WEPOKER_STANDARD_POSTGRES=1 vitest run src/modules/tables/recovery/recovery-process.integration.test.ts --config vitest.integration.config.ts",
    "test:action-idempotency": "cross-env WEPOKER_STANDARD_POSTGRES=1 vitest run src/realtime/realtime.integration.test.ts --config vitest.integration.config.ts -t \"durable replays|authoritative two-player\"",
    "test:settlement-exactly-once": "cross-env WEPOKER_STANDARD_POSTGRES=1 vitest run src/modules/tables/hand-persistence.integration.test.ts --config vitest.integration.config.ts",
    "test:runtime-cleanup": "vitest run src/modules/tables/runtime/table-runtime-manager.test.ts --config vitest.config.ts",
    "test:realtime": "cross-env WEPOKER_STANDARD_POSTGRES=1 vitest run src/realtime/realtime.integration.test.ts src/realtime/multiplayer.integration.test.ts --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:docker:up": "tsx scripts/docker-database-command.ts up",
    "db:docker:down": "tsx scripts/docker-database-command.ts down",
    "db:docker:status": "tsx scripts/docker-database-command.ts status",
    "db:docker:logs": "tsx scripts/docker-database-command.ts logs",
    "db:docker:reset:dev": "cross-env WEPOKER_ENV_FILE=../../.env.docker.dev WEPOKER_EXPECTED_DATABASE=wepoker_dev tsx scripts/reset-database-schema.ts",
    "db:docker:reset:test": "cross-env WEPOKER_ENV_FILE=../../.env.docker.test WEPOKER_EXPECTED_DATABASE=wepoker_test tsx scripts/reset-database-schema.ts",
    "db:migrate:docker": "cross-env WEPOKER_ENV_FILE=../../.env.docker.dev prisma migrate deploy",
    "db:migrate:test:docker": "cross-env WEPOKER_ENV_FILE=../../.env.docker.test prisma migrate deploy",
    "db:seed:docker": "cross-env WEPOKER_ENV_FILE=../../.env.docker.dev prisma db seed",
    "db:seed:test:docker": "cross-env WEPOKER_ENV_FILE=../../.env.docker.test prisma db seed",
    "db:dev:start": "tsx scripts/database-command.ts dev:start",
    "db:dev:stop": "tsx scripts/database-command.ts dev:stop",
    "db:test:start": "tsx scripts/database-command.ts test:start",
    "db:test:stop": "tsx scripts/database-command.ts test:stop",
    "db:test:reset": "tsx scripts/reset-test-database.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "cross-env WEPOKER_ENV_FILE=../../.env.test prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:test": "cross-env WEPOKER_ENV_FILE=../../.env.test prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@paiyouju/poker-core": "workspace:*",
    "@paiyouju/shared": "workspace:*",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.3",
    "pg": "8.23.0",
    "socket.io": "4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "cross-env": "10.1.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
