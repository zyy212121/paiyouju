{
  "name": "@paiyouju/web",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:browsers": "corepack pnpm --filter @paiyouju/server exec cross-env WEPOKER_E2E_MODE=browsers tsx scripts/run-docker-e2e.ts",
    "test:e2e:browsers:local": "playwright test --config playwright.release.config.ts",
    "test:e2e:production-like": "playwright test --config playwright.production-like.config.ts",
    "test:e2e:restored-data": "playwright test --config playwright.restore.config.ts",
    "test:e2e:pwa": "node scripts/run-pwa-e2e.mjs"
  },
  "dependencies": {
    "@paiyouju/shared": "workspace:*",
    "lucide-react": "^1.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "socket.io-client": "4.8.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-window": "7.4.1"
  }
}
