# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
APP_VERSION=0.0.0-dev
APP_DOMAIN=localhost
# Reversible connection/start-gate probes; only administrator-owned room NDJSON files receive them.
ADMIN_ROOM_CONNECTION_PROBES_ENABLED=true
ADMIN_ROOM_FILE_LOG_ENABLED=true

# PostgreSQL. Step 6 development uses Docker PostgreSQL on localhost:55432.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/wepoker_dev?schema=public
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/wepoker_shadow?schema=public
# Standard PostgreSQL must use a real multi-connection pool.
DATABASE_POOL_MAX=10
MAX_SOCKETS_PER_USER=5
RUNTIME_IDLE_EVICTION_SECONDS=300
BACKUP_RETENTION_DAYS=7

# Server-side sessions (tokens are random and hashed; no SESSION_SECRET is used).
SESSION_COOKIE_NAME=wepoker_session
SESSION_TTL_DAYS=14

# Virtual points and development-only seed accounts. Seed phone numbers are
# documented placeholders; passwords must stay local and must never be committed.
INITIAL_USER_POINTS=10000
DEV_SEED_PASSWORD=change-me-for-local-development
BOT_ACCOUNT_PASSWORD=change-me-for-local-test-bots
ADMIN_USERNAME=admin
ADMIN_NICKNAME=管理员

# Test runner only. Never set outside NODE_ENV=test.
# TEST_FIXED_DECK=standard
# TEST_FIXED_DECK=step6_5_acceptance

# Phone registration/login, history, whole-hand paid reveal, hypothetical runout,
# PWA cache rules and Lucide UI require no extra secrets. Paid reveal is per Room.

# Production Caddy address; replace with a real DNS name on the server.
CADDY_SITE_ADDRESS=localhost
