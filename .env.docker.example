# Copy to .env.docker for Docker Compose. This file contains examples only.
POSTGRES_DEV_USER=wepoker
POSTGRES_DEV_PASSWORD=replace-with-a-local-development-password
POSTGRES_DEV_DB=wepoker_dev

POSTGRES_TEST_USER=wepoker_test
POSTGRES_TEST_PASSWORD=replace-with-a-local-test-password
POSTGRES_TEST_DB=wepoker_test

# Also copy the application sections below into ignored .env.docker.dev and
# .env.docker.test files, replacing passwords with the matching local values.
# Development URL: postgresql://wepoker:<password>@127.0.0.1:55432/wepoker_dev?schema=public
# Test URL: postgresql://wepoker_test:<password>@127.0.0.1:55433/wepoker_test?schema=public
# Both application environments must set DATABASE_POOL_MAX=10 or greater.
# Seed phone identifiers, DEV_SEED_PASSWORD and BOT_ACCOUNT_PASSWORD are development/test-only. There
# is no SMS provider, payment provider, phone verification secret or chat backend.
# Production does not use this file. Copy `.env.production.example` to the
# ignored `.env.production`, replace every placeholder and use compose.prod.yaml.
