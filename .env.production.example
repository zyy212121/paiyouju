# Copy to an untracked .env.production and replace every placeholder before startup.
NODE_ENV=production
APP_VERSION=0.1.0-rc.1
APP_DOMAIN=poker.example.com
PORT=3000

POSTGRES_DB=wepoker
POSTGRES_USER=wepoker
POSTGRES_PASSWORD=replace-with-random-32-plus-characters
DATABASE_URL=postgresql://wepoker:replace-with-random-32-plus-characters@postgres:5432/wepoker?schema=public
DATABASE_POOL_MAX=10

CLIENT_ORIGIN=https://poker.example.com
SESSION_COOKIE_NAME=wepoker_session
SESSION_TTL_DAYS=14
INITIAL_USER_POINTS=10000
ALLOW_LEGACY_USERNAME_LOGIN=false
LOG_LEVEL=info
ADMIN_ROOM_CONNECTION_PROBES_ENABLED=false
ADMIN_ROOM_FILE_LOG_ENABLED=false

MAX_SOCKETS_PER_USER=5
RUNTIME_IDLE_EVICTION_SECONDS=300
BACKUP_RETENTION_DAYS=7

# Backup paths resolve against the checkout root; the destination must be outside it.
# WEPOKER_BACKUP_DIR=../paiyouju-backups
